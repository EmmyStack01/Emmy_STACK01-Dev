---
// Shared shell for every admin tool: header, sign-in gate, and a content area that stays hidden until an admin is signed in.
// Usage: <AdminLayout title="Partner Desk" active="partners"> ...tool markup... </AdminLayout>
const { title, active = "", description = "Private tools for Emmy STACK01." } = Astro.props;
const tools = [
  { id: "partners", name: "Partner Desk", href: "/partners", icon: "ri-user-search-line", live: true },
  { id: "password", name: "Password generator", href: "/password", icon: "ri-lock-password-line", live: true },
  { id: "documents", name: "Document engine", href: "/documents", icon: "ri-file-text-line", live: true },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow, noarchive">
  <meta name="theme-color" content="#0b1020">
  <title>{title} | Emmy STACK01 Dev Tools</title>
  <meta name="description" content={description}>

  <link rel="apple-touch-icon" sizes="180x180" href="https://emmystack01.com/favicon_io/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="https://emmystack01.com/favicon_io/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="https://emmystack01.com/favicon_io/favicon-16x16.png">
  <link rel="manifest" href="https://emmystack01.com/favicon_io/site.webmanifest">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Manrope:wght@400..800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css" rel="stylesheet">
  <link rel="stylesheet" href="/admin.css">
  <slot name="head" />
</head>
<body>
  <header class="top">
    <a class="brand" href="/">Emmy STACK01 <span>Dev tools</span></a>
    <nav class="tabs" aria-label="Tools" id="tabs" hidden>
      {tools.map((t) => t.live
        ? <a href={t.href} class:list={["tab", { on: active === t.id }]} aria-current={active === t.id ? "page" : undefined}><i class={t.icon} aria-hidden="true"></i><span>{t.name}</span></a>
        : <span class="tab off" title="Coming soon"><i class={t.icon} aria-hidden="true"></i><span>{t.name}</span></span>)}
    </nav>
    <div class="who" id="who" hidden>
      <span id="whoEmail" class="who-email"></span>
      <button type="button" class="btn ghost sm" id="logoutBtn"><i class="ri-logout-box-r-line" aria-hidden="true"></i> Sign out</button>
    </div>
  </header>

  <!-- Checking the session -->
  <section class="center" id="loading" aria-live="polite"><p class="muted">Checking your session…</p></section>

  <!-- Sign-in gate -->
  <section class="center" id="gate" hidden aria-label="Admin sign in">
    <div class="card gate-card">
      <form id="aEmailForm" novalidate>
        <h1>Admin sign in</h1>
        <p class="sub">Enter your admin email. We send a one-time code. Only approved addresses get in.</p>
        <div class="field"><label for="aEmail">Email</label><input class="input" type="email" id="aEmail" autocomplete="email" inputmode="email" required></div>
        <button type="submit" class="btn primary block" id="aEmailBtn">Email me a code</button>
        <p class="msg" id="aEmailMsg" role="status" aria-live="polite"></p>
      </form>
      <form id="aCodeForm" novalidate hidden>
        <h1>Check your email</h1>
        <p class="sub">We sent a code to <strong id="aSentTo"></strong>.</p>
        <div class="field"><label for="aOtp">Code</label><input class="input otp" type="text" id="aOtp" inputmode="numeric" autocomplete="one-time-code" maxlength="10" pattern="[0-9]{6,10}" placeholder="123456" required></div>
        <button type="submit" class="btn primary block" id="aCodeBtn">Sign in</button>
        <p class="msg" id="aCodeMsg" role="status" aria-live="polite"></p>
        <p class="switch"><button type="button" class="link" id="aResend">Send a new code</button> &middot; <button type="button" class="link" id="aChange">Use a different email</button></p>
      </form>
    </div>
  </section>

  <!-- The tool itself (hidden until an admin is signed in) -->
  <main id="app" hidden>
    <slot />
  </main>

  <script src="/admin.js" is:inline></script>
  <slot name="scripts" />
</body>
</html>
