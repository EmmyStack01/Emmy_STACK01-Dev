---
import AdminLayout from "../layouts/AdminLayout.astro";
---
<AdminLayout title="Password Generator" active="password" description="Generate strong passwords or memorable phrases for client accounts.">
  <link slot="head" rel="stylesheet" href="/password.css">

  <div class="wrap pw">
    <h1 class="page-title">Password generator</h1>
    <p class="page-sub">Made in your browser. Nothing is sent or saved anywhere.</p>

    <section class="card pw-out" aria-label="Generated password">
      <div class="pw-box" id="pwText" role="textbox" aria-readonly="true" aria-label="Generated password" tabindex="0"></div>
      <div class="pw-meter" aria-hidden="true"><i id="pwBar"></i></div>
      <p class="pw-meta"><b id="pwLabel"></b><span id="pwBits" class="muted"></span></p>
      <div class="pw-btns">
        <button type="button" class="btn primary" id="pwCopy"><i class="ri-file-copy-line" aria-hidden="true"></i> <span>Copy</span></button>
        <button type="button" class="btn ghost" id="pwNew"><i class="ri-refresh-line" aria-hidden="true"></i> New</button>
      </div>
      <p class="msg" id="pwMsg" role="status" aria-live="polite"></p>
    </section>

    <section class="card pw-opts" aria-label="Options">
      <fieldset class="pw-group">
        <legend>Type</legend>
        <div class="seg" role="radiogroup" aria-label="Password type">
          <label class="seg-opt"><input type="radio" name="mode" value="all" checked><span>All<br>characters</span></label>
          <label class="seg-opt"><input type="radio" name="mode" value="alnum"><span>Letters +<br>numbers</span></label>
          <label class="seg-opt"><input type="radio" name="mode" value="custom"><span>Pick<br>my own</span></label>
          <label class="seg-opt"><input type="radio" name="mode" value="phrase"><span>Memorable<br>phrase</span></label>
        </div>
      </fieldset>

      <fieldset class="pw-group" id="customBox" hidden>
        <legend>Include</legend>
        <div class="checks">
          <label class="check"><input type="checkbox" id="cLetters" checked> Letters (A–Z, a–z)</label>
          <label class="check"><input type="checkbox" id="cNumbers" checked> Numbers (0–9)</label>
          <label class="check"><input type="checkbox" id="cSymbols" checked> Symbols (!@#$%&amp;*-_=+?.)</label>
        </div>
      </fieldset>

      <fieldset class="pw-group">
        <legend>Length</legend>
        <div class="pw-len">
          <button type="button" class="pw-step" id="lenDown" aria-label="One shorter"><i class="ri-subtract-line" aria-hidden="true"></i></button>
          <input class="input pw-num" type="number" id="lenNum" min="10" max="128" step="1" value="16" inputmode="numeric" aria-label="Password length, 10 to 128">
          <button type="button" class="pw-step" id="lenUp" aria-label="One longer"><i class="ri-add-line" aria-hidden="true"></i></button>
        </div>
        <input type="range" id="len" min="10" max="128" step="1" value="16" aria-label="Password length slider">
        <div class="pw-ticks" aria-hidden="true"><span>10</span><span>128</span></div>
        <p class="pw-hint" id="lenHint" role="status" aria-live="polite">Choose 10 to 128 characters.</p>
      </fieldset>

      <label class="check pw-look" id="lookBox"><input type="checkbox" id="noLook"> Avoid look-alike characters (O 0 l 1 I)</label>
    </section>
  </div>

  <script slot="scripts" src="/password.js" is:inline></script>
</AdminLayout>
